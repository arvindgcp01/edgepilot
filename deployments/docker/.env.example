# EdgePilot single-node configuration.
#
# Copy to .env, fill every value, and chmod 0600. This file holds the keys that
# protect every session and every TOTP secret in the deployment.
#
# Generate the secrets with:
#
#   openssl rand -base64 32                      # POSTGRES_PASSWORD
#   openssl rand -base64 32                      # REDIS_PASSWORD
#   openssl genpkey -algorithm ed25519           # EP_JWT_PRIVATE_KEY (paste the PEM, or base64 it)
#   openssl rand -hex 32                         # EP_DATA_KEY

# --- database and cache ----------------------------------------------------

POSTGRES_USER=edgepilot
POSTGRES_PASSWORD=
POSTGRES_DB=edgepilot
REDIS_PASSWORD=

# --- identity --------------------------------------------------------------

# Signs access tokens. Rotating it invalidates every session at once, which is
# the correct response to a suspected disclosure.
EP_JWT_PRIVATE_KEY=

# Seals TOTP secrets at rest (AES-256-GCM). Losing it means every enrolled
# second factor has to be re-enrolled; disclosing it means they are all forgeable.
# Back it up separately from the database — a backup containing both is a backup
# that defeats the encryption.
EP_DATA_KEY=

# --- addressing ------------------------------------------------------------

# The hostname operators reach the dashboard on. Also enables per-tenant
# subdomain resolution at login when a deployment serves several organizations.
EP_PUBLIC_HOST=

# host:port agents dial for the device plane. It must match a name or address in
# the certificate issued by `epctl ca server-cert`, because the agent verifies it.
EP_DEVICE_PLANE_ENDPOINT=

# Where to bind the API on the host. Leave as localhost when a reverse proxy
# terminates TLS in front of it; set 0.0.0.0 only if something else is doing so.
EP_HTTP_BIND=127.0.0.1

# What Caddy serves on. A hostname (edgepilot.example.com) makes it obtain a
# certificate automatically, which is what the Secure refresh cookie requires.
# A bare :80 serves plain HTTP and sessions will not survive a page reload.
EP_SITE_ADDRESS=

# Leave empty for a real hostname; set to "tls internal" when serving on an IP
# address or behind a firewall Let's Encrypt cannot reach. HTTPS is required
# either way: the refresh cookie is Secure, and a browser discards it over
# plain HTTP.
EP_TLS_DIRECTIVE=

# The hostname or IP address clients connect to. A client dialling an IP sends
# no SNI, and without this Caddy has no name to match a site against.
EP_DEFAULT_SNI=

# Browser origins allowed to call the API. Empty means same-origin only, which
# is the right answer when Caddy serves both from one origin.
EP_HTTP_ALLOWED_ORIGINS=

# --- optional --------------------------------------------------------------

# production or staging. See the comment on EP_ENV in docker-compose.yml: a
# single-node stack with a non-TLS Docker-network database is staging, and the
# server will refuse to start if you claim otherwise.
EP_ENV=staging

EP_REPLICA_ID=node-1
EP_LOG_LEVEL=info

# Ed25519 keys agents pin for artifact and agent-release signatures, comma
# separated. Empty until software deployment is in use.
EP_SIGNING_PUBLIC_KEYS=

EP_VERSION=dev
EP_COMMIT=none
